{
  "name": "xfcmd",
  "displayName": "xfcmd",
  "description": "XFCMD scripting language, CLI, automation and VS Code support.",
  "version": "0.1.0",
  "publisher": "fscss-ttr",
  "license": "MIT",
  "type": "module",
  "main": "./vscode/extension.js",
  "bin": {
    "xfcmd": "./bin/xfcmd.js"
  },
  "engines": {
    "node": ">=18.17",
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:xfcmd"
  ],
  "contributes": {
    "languages": [
      {
        "id": "xfcmd",
        "aliases": ["xfcmd", "XFCMD"],
        "extensions": [".xfcmd"],
        "configuration": "./vscode/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xfcmd",
        "scopeName": "source.xfcmd",
        "path": "./vscode/syntaxes/xfcmd.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "xfcmd",
        "path": "./vscode/snippets/xfcmd.json"
      }
    ]
  }
}

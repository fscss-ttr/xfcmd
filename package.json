    "./pkg": "./src/pkg.js"
  },
  "files": ["bin", "src", "README.md"],
  "scripts": { "test": "node --test" },
  "engines": { "node": ">=18.17" },
  "keywords": ["fscss", "xfscss", "xfcmd", "cli", "scaffold", "automation", "css"],
  "repository": { "type": "git", "url": "git+https://github.com/fscss-ttr/xfcmd.git" },
